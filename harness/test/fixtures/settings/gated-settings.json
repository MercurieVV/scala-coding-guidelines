{"env":{"MILL_OUTPUT_DIR":"out-agent"},
 "sandbox":{"enabled":true,"network":{"allowLocalBinding":true},"filesystem":{"denyRead":["./holdout","/hsrc"],"allowWrite":[]}},
 "permissions":{"deny":["Read(./holdout/**)"],"note":"café — ok"},
 "hooks":{"SessionStart":[{"hooks":[{"type":"command","command":"sh \"$CLAUDE_PROJECT_DIR/.dsh/engine/gate.sh\" baseline","timeout":60}]}],
  "PreToolUse":[{"matcher":"Bash","hooks":[{"type":"command","command":"sh \"$CLAUDE_PROJECT_DIR/.dsh/engine/gate.sh\" tool-policy","timeout":30}]},
   {"matcher":"Read|Bash","hooks":[{"type":"command","command":"sh \"$CLAUDE_PROJECT_DIR/.dsh/engine/gate.sh\" semantic-guard"}]}],
  "PostToolUse":[{"matcher":"Edit|Write","hooks":[{"type":"command","command":"sh \"$CLAUDE_PROJECT_DIR/.dsh/engine/gate.sh\" post-edit","timeout":600}]}],
  "Stop":[{"hooks":[{"type":"command","command":"sh \"$CLAUDE_PROJECT_DIR/.dsh/engine/gate.sh\" turn-end","timeout":600}]}]}}
